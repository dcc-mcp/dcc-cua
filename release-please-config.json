{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "7ca17c38919e4cd40f5ce1fd05160349f6b88d70",
  "release-type": "simple",
  "include-component-in-tag": false,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "dcc-cua",
      "version-file": "version.txt",
      "include-component-in-tag": false,
      "exclude-paths": [
        "browser-extension/**"
      ]
    },
    "browser-extension/chrome": {
      "release-type": "node",
      "component": "dcc-cua-chrome",
      "package-name": "@dcc-mcp/dcc-cua-chrome",
      "include-component-in-tag": true,
      "release-as": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "component-manifest.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
