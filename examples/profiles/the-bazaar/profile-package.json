{
  "schema_version": 2,
  "kind": "dcc-cua-profile-package",
  "id": "the-bazaar",
  "version": "2.0.0",
  "display_name": "The Bazaar",
  "description": "Adaptive The Bazaar CUA vocabulary, policy, fixtures, and an independently launched read-only semantic companion.",
  "license": "MIT",
  "artifacts": [
    {"type": "semantic_profile", "path": "profile.json"},
    {"type": "context_index", "path": "knowledge/index.seed.json"},
    {"type": "context_document", "path": "knowledge/base-rules.seed.json"},
    {"type": "agent_skill", "path": "SKILL.md"},
    {"type": "documentation", "path": "README.md"},
    {"type": "license", "path": "LICENSE"},
    {"type": "fixtures", "path": "fixtures"},
    {"type": "companion_source", "path": "companion"}
  ],
  "requires": {"dcc_cua": ">=0.6.0"},
  "platforms": ["windows"]
}
