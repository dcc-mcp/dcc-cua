{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcc-mcp.dev/schemas/dcc-cua/semantic-profile-v3.schema.json",
  "title": "DCC CUA semantic Profile v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "profile_version", "application", "display_name", "settings"],
  "properties": {
    "schema_version": {"const": 3},
    "id": {"$ref": "#/$defs/id"},
    "profile_version": {"$ref": "#/$defs/semver"},
    "application": {"$ref": "#/$defs/application"},
    "extends": {"$ref": "#/$defs/profile_reference"},
    "display_name": {"type": "string", "minLength": 1},
    "selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
    "surfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}},
    "state_sources": {"type": "array", "items": {"$ref": "#/$defs/state_source"}},
    "binding": {"$ref": "#/$defs/binding"},
    "capability_probes": {"type": "array", "items": {"$ref": "#/$defs/capability_probe"}},
    "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}},
    "settings": {"$ref": "#/$defs/settings"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9._-]{1,80}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "string_array": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "localized_aliases": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
      "additionalProperties": {"$ref": "#/$defs/string_array"}
    },
    "application": {
      "type": "object", "additionalProperties": false, "required": ["family"],
      "properties": {
        "family": {"type": "string", "minLength": 1, "maxLength": 80},
        "versions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 32}}
      }
    },
    "profile_reference": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}}
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "application_names": {"$ref": "#/$defs/string_array"},
        "window_title_contains": {"$ref": "#/$defs/string_array"},
        "localized_window_title_contains": {"$ref": "#/$defs/localized_aliases"},
        "url_hosts": {"$ref": "#/$defs/string_array"}
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "role", "route"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "route": {"enum": ["unreal_typed_api", "accessibility", "browser_dom", "os_native_dialog", "visual_fallback"]},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "names": {"$ref": "#/$defs/string_array"},
        "localized_names": {"$ref": "#/$defs/localized_aliases"},
        "automation_ids": {"$ref": "#/$defs/string_array"},
        "supported_actions": {"$ref": "#/$defs/string_array"},
        "key_bindings": {
          "type": "object",
          "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 32}}
        },
        "fallback": {"$ref": "#/$defs/fallback"}
      }
    },
    "fallback": {
      "type": "object", "additionalProperties": false, "required": ["profile_id", "surface_id"],
      "properties": {"profile_id": {"$ref": "#/$defs/id"}, "surface_id": {"$ref": "#/$defs/id"}}
    },
    "state_source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "mode", "url", "expected_schema_version", "schema_version_pointer", "tick_pointer", "timeout_ms", "max_response_bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "loopback_http_json"},
        "mode": {"const": "read_only"},
        "url": {"type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\]):[0-9]+/[^?#]*$"},
        "expected_schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "schema_version_pointer": {"type": "string", "pattern": "^/", "maxLength": 256},
        "tick_pointer": {"type": "string", "pattern": "^/", "maxLength": 256},
        "use_etag": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "minimum": 50, "maximum": 10000},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 8388608},
        "optional": {"type": "boolean"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "require_exact_pid": {"type": "boolean"},
        "require_exact_window_handle": {"type": "boolean"},
        "require_window_version_match": {"type": "boolean"},
        "fail_closed_on_ambiguity": {"type": "boolean"}
      }
    },
    "capability_probe": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "route", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "route": {"enum": ["accessibility", "browser_dom"]},
        "capabilities": {"$ref": "#/$defs/string_array"},
        "optional": {"type": "boolean"}
      }
    },
    "flow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "surface_id", "action_target_id", "verify_target_id", "route"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "surface_id": {"$ref": "#/$defs/id"},
        "action_target_id": {"$ref": "#/$defs/id"},
        "verify_target_id": {"$ref": "#/$defs/id"},
        "route": {"enum": ["accessibility", "browser_dom"]},
        "requires_fresh_snapshot": {"type": "boolean"},
        "requires_post_action_verification": {"type": "boolean"},
        "prohibit_coordinates": {"type": "boolean"},
        "prohibit_keyboard_shortcuts": {"type": "boolean"}
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false, "required": ["dialog_style", "preferred_route"],
      "properties": {
        "dialog_style": {"enum": ["os_native", "host_owned", "application_rendered"]},
        "preferred_route": {"enum": ["unreal_typed_api", "accessibility", "browser_dom", "os_native_dialog", "visual_fallback"]},
        "default_locale": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$", "maxLength": 35},
        "destructive_confirmation_required": {"type": "boolean"}
      }
    }
  }
}
